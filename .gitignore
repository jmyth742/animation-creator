# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/

# Environment / secrets
.env
.env.local
.env.sh
!.env.example
!app/backend/.env.example
!training/.env.example

# Node
node_modules/
dist/
.vite/

# Database
*.db
*.sqlite

# Models & large binaries (too large for git)
*.gguf
*.safetensors
*.pt
*.pth
*.bin

# ComfyUI (install separately — ~100GB with models)
ComfyUI/

# Generated output
output/
ambience/

# Generated series data (keep templates and concept files)
series/*/continuity/
# bible.json and episodes/ were ignored as "generated series data" back when
# Claude wrote them from a concept file. They are not generated any more --
# every line of ep05 through ep10 was hand-authored, rewritten against measured
# TTS timings, and is the actual creative work. Together they are ~60KB. Losing
# the scripts while keeping the code that renders them would be exactly the
# wrong half to back up.
!series/*/bible.json
!series/*/episodes/
# The nine character anchors: 5MB, and every plate, every staged shot and every
# LoRA in the series descends from them. Regenerating changes the characters.
!series/*/reference_images/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code
.claude/
CLAUDE.md
PROJECT_OVERVIEW.md

# Training
training/.env
training/logs/

# Job runner state — pids, logs, per-run checkpoints. Machine-local.
.jobs/

# Generated imagery. Reference plates, staged sets and training builds are all
# reproducible from the scripts plus the bible, and run to hundreds of MB.
series/*/sets/
training/character_builds/
series/*/continuity/

# Hardcoded an API key in line 5. Removed from history; never track it again.
run_all_enhanced.sh
